{
	"root": true,
	"extends": [
		"wikimedia/common",
		"wikimedia/language/es2020"
	],
	"rules": {
		"comma-dangle": "off",
		"no-implicit-globals": "off",
		"operator-linebreak": [ "error", "before" ]
	},
	"env": {
		"browser": true
	},
	"overrides": [
		{
			"files": [ "tests/**/*.js" ],
			"env": {
				"node": true
			}
		}
	]
}
